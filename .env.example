# GEMINI_API_KEY: REQUIRED for Gemini AI API calls (default provider).
# NOTE for GitHub Actions: configure this as a repository secret named GEMINI_API_KEY,
# because GitHub-hosted runners cannot reach the domestic Doubao(Volcengine) endpoint.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DINGTALK_WEBHOOK: The webhook URL for your DingTalk bot.
DINGTALK_WEBHOOK=""

# KEYWORDS: Comma-separated keywords for news scraping.
KEYWORDS="AI技术, 自动驾驶, 半导体"

# LLM_MODEL: The Gemini model to use.
LLM_MODEL="gemini-3-flash-preview"

# --- AI PROVIDER ---
# AI_PROVIDER: "gemini" (recommended, globally reachable) or "doubao".
# Doubao/Volcengine uses the domestic endpoint https://ark.cn-beijing.volces.com/api/v3,
# which CANNOT be reached from GitHub-hosted (US/EU) runners -> use "gemini" in CI.
AI_PROVIDER="gemini"
# DOUBAO_API_KEY: Your Doubao API Key from Volcengine
DOUBAO_API_KEY="569ada4e-901b-4047-b61c-0bd28394c4bf"
# DOUBAO_ENDPOINT: Doubao API endpoint (e.g., https://ark.cn-beijing.volces.com/api/v3)
DOUBAO_ENDPOINT="https://ark.cn-beijing.volces.com/api/v3"
# DOUBAO_MODEL: Your Doubao Model Endpoint ID (e.g., ep-2024xxxx)
DOUBAO_MODEL="ep-20260408145200-vrvqm"

# --- BUSINESS CONTEXT (Optional) ---
# USER_CONTEXT: Background info for AI analysis.
USER_CONTEXT="作为投资机构从业者，我需要结合关键词为机构做出每日分析"
# FOCUS_MEDIA: Comma-separated list of media to prioritize.
FOCUS_MEDIA="SpaceNews, Sputnik News, Via Satellite, 卫星与网络, Space Daily"
